<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<GridPane
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.LoginController"
    minHeight="600.0"
    prefWidth="1200.0"
    prefHeight="760.0"
    stylesheets="@style.css">

    <columnConstraints>
        <!-- Kolom Kiri: 50% -->
        <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
        <!-- Kolom Kanan: 50% -->
        <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints vgrow="ALWAYS" />
    </rowConstraints>

    <!-- ═══════════════════════════════════════════════════════
         KOLOM KIRI — Dark panel (#171717)
         ═══════════════════════════════════════════════════════ -->
    <VBox
        GridPane.columnIndex="0"
        GridPane.rowIndex="0"
        styleClass="login-left"
        style="-fx-background-color: #171717;"
        VBox.vgrow="ALWAYS">

        <!-- TOP: System label -->
        <VBox style="-fx-padding: 40 40 0 40;">
            <Label
                text="SISTEM MANAJEMEN PARKIR"
                style="-fx-font-family: 'IBM Plex Mono', 'Consolas', monospace;
                       -fx-font-size: 12px;
                       -fx-text-fill: #aaa;" />
        </VBox>

        <!-- MIDDLE: Stretch content -->
        <VBox
            VBox.vgrow="ALWAYS"
            alignment="CENTER_LEFT"
            spacing="24"
            style="-fx-padding: 48 40 48 40;">

            <!-- Headline -->
            <Label
                wrapText="true"
                style="-fx-font-size: 48px;
                       -fx-font-weight: bold;
                       -fx-text-fill: white;
                       -fx-line-spacing: 4;">
                <text>Parkir tertata.&#10;Operasional terjaga.</text>
            </Label>

            <!-- Description -->
            <Label
                text="Kelola kendaraan, ketersediaan slot, dan pendapatan dalam satu ruang kerja."
                wrapText="true"
                style="-fx-font-size: 14px;
                       -fx-text-fill: #bcbcbc;
                       -fx-line-spacing: 2;" />
        </VBox>

    </VBox>

    <!-- ═══════════════════════════════════════════════════════
         KOLOM KANAN — Light panel (#fafafa)
         ═══════════════════════════════════════════════════════ -->
    <StackPane
        GridPane.columnIndex="1"
        GridPane.rowIndex="0"
        styleClass="login-right"
        style="-fx-background-color: #fafafa;"
        alignment="CENTER">

        <!-- Form container: max-width 380px, centered -->
        <VBox
            maxWidth="380.0"
            spacing="24"
            style="-fx-padding: 0 0 0 0;">

            <!-- "Masuk ke akun" -->
            <Label
                fx:id="lblLoginTitle"
                text="Masuk ke akun"
                styleClass="login-title"
                wrapText="false" />

            <!-- Subtitle -->
            <Label
                fx:id="lblLoginSubtitle"
                text="Gunakan akun petugas untuk melanjutkan."
                style="-fx-font-size: 14px;
                       -fx-text-fill: #666;"
                wrapText="true" />

            <!-- USERNAME field -->
            <VBox spacing="8">
                <Label
                    text="USERNAME"
                    styleClass="field-label" />
                <TextField
                    fx:id="txtUsername"
                    promptText="Masukkan username"
                    styleClass="input-field"
                    maxWidth="Infinity" />
            </VBox>

            <VBox fx:id="boxInitialName" spacing="8" visible="false" managed="false">
                <Label text="NAMA PETUGAS PERTAMA" styleClass="field-label" />
                <TextField fx:id="txtInitialName" promptText="Masukkan nama petugas" styleClass="input-field" maxWidth="Infinity" />
            </VBox>

            <!-- PASSWORD field -->
            <VBox spacing="8">
                <Label
                    text="PASSWORD"
                    styleClass="field-label" />
                <PasswordField
                    fx:id="txtPassword"
                    promptText="Masukkan password"
                    styleClass="input-field"
                    maxWidth="Infinity" />
            </VBox>

            <!-- Login button -->
            <Button
                fx:id="btnLogin"
                text="MASUK KE DASHBOARD"
                styleClass="btn-primary"
                maxWidth="Infinity"
                onAction="#handleLogin">
                <graphic><SVGPath content="M2 12h18 M14 6l6 6-6 6" style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 1.8;" /></graphic>
            </Button>

            <Button
                fx:id="btnInitialSetup"
                text="BUAT AKUN ADMIN PERTAMA"
                styleClass="btn-secondary"
                maxWidth="Infinity"
                visible="false"
                managed="false"
                onAction="#handleInitialSetup" />

            <!-- Notice / Error label -->
            <Label
                fx:id="lblNotice"
                text=""
                wrapText="true"
                maxWidth="Infinity"
                style="-fx-font-size: 13px;
                       -fx-text-fill: #202020;" />


        </VBox>

    </StackPane>

</GridPane>
